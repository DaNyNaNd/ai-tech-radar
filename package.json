{
  "name": "ai-tech-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "description": "Daily software engineering and AI tooling radar with OpenAI summarization and Telegram delivery.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "run": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "format": "prettier --write .",
    "review": "node --env-file-if-exists=.env --import tsx src/cli/review.ts",
    "log-action": "node --env-file-if-exists=.env --import tsx src/cli/log-action.ts"
  },
  "dependencies": {
    "openai": "^6.4.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
